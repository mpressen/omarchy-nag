#!/bin/bash
#
# nag - disposable alarms for the Omarchy bar.
#
# One text field takes both the time and the message: "15:15 pick up the kids",
# "5m tea", "tomorrow 9:00 dentist". This script owns all of the parsing, so the
# panel never has to know what a valid time looks like and there is exactly one
# place to fix when it gets something wrong.
#
# Alarms are systemd user timers set with --on-calendar, which means they are
# anchored to wall-clock time and survive a shell restart, a Quickshell crash
# and a suspend. That last one is the reason for --on-calendar over the
# --on-active that the built-in `omarchy reminder` uses: OnActiveSec counts
# monotonic seconds, which stop while the machine sleeps, so an alarm set for
# 15:15 fires late by however long the lid was shut.
#
# Every alarm is also written to disk, and `list` puts back any timer that has
# gone missing while its time is still ahead. That covers a reboot, which
# transient systemd units do not survive on their own.

set -euo pipefail
shopt -s nullglob

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nag"
readonly ALARM_DIR="$STATE_DIR/alarms"
readonly RING_DIR="$STATE_DIR/ringing"
readonly CARD_DIR="$STATE_DIR/cards"
readonly DEMO_FILE="$STATE_DIR/demo"

# Bounds. The panel is one text field on a shared, long-lived shell process, so
# everything that comes out of it is capped at the producer rather than trusted
# to be reasonable.
readonly MAX_ALARMS=64
readonly MAX_MESSAGE=80
readonly MAX_SPEC=200
readonly MAX_SNOOZE_MINUTES=1440
readonly MAX_RING_MINUTES=60
# The shortest interval, "every 1s": each occurrence takes over the card and
# the ring of the one before.
readonly MIN_INTERVAL=1
# One alarm document is a handful of fields, so anything approaching this is
# either corruption or somebody else's file.
readonly MAX_STATE_BYTES=4096
# Played when the `sound` setting names no readable file.
readonly DEFAULT_SOUND="/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"
# nf-md-timer, the same glyph the bar widget wears, so a Nag notification is
# recognisable as one at a glance instead of looking like every other toast.
readonly DEFAULT_GLYPH=$'󰔟'

SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
readonly SELF

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() {
  jq -cn --arg error "$1" '{ok: false, error: $error}'
  exit 0
}

ok_json() { jq -cn "$@"; }

# One of the widget's settings from shell.json, empty when unset. Read only
# when an alarm or a notification goes out: `list` and `parse` run every few
# seconds and have no use for them.
widget_setting() {
  omarchy-bar get jankeesvw.nag "$1" 2>/dev/null || true
}

# The on/off settings are on unless set to false.
setting_off() { [[ $(widget_setting "$1") == "false" ]]; }

# A plain decimal within [min, max]. Base 10: bash reads a leading zero as octal.
int_in() { [[ $1 =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= $2 && 10#$1 <= $3)); }

# A number setting, or the fallback when it is unset or out of range.
int_setting() {
  local value
  value=$(widget_setting "$1")
  if int_in "$value" "$2" "$3"; then printf '%d' $((10#$value)); else printf '%d' "$4"; fi
}

snooze_minutes() { int_setting snoozeMinutes 1 "$MAX_SNOOZE_MINUTES" 5; }

# How long an alarm rings before it is reported missed.
ring_minutes() { int_setting ringMinutes 1 "$MAX_RING_MINUTES" 5; }

# The `icon` setting when there is one, so the notification wears the glyph the
# bar does.
glyph() {
  local icon
  icon=$(strip_markup "$(widget_setting icon)")
  icon=${icon:0:4}
  printf '%s' "${icon:-$DEFAULT_GLYPH}"
}

# Any process running as this user can plant a symlink or a FIFO on a path it
# can predict, and every path here is predictable. So a directory that is not a
# real directory we own is refused rather than repaired, and the mode is put
# back on every run.
harden_dir() {
  local dir="$1"
  [[ -L $dir ]] && { echo "nag: $dir is a symlink, refusing" >&2; return 1; }
  mkdir -p -m 700 -- "$dir" 2>/dev/null || true
  [[ -d $dir && ! -L $dir ]] || { echo "nag: $dir is not a directory" >&2; return 1; }
  [[ -O $dir ]] || { echo "nag: $dir is not ours" >&2; return 1; }
  chmod 700 -- "$dir" 2>/dev/null || true
}

# The two leaf directories hold nothing but alarm documents, so anything in
# there that is not a regular file was not put there by this plugin and goes.
# find uses lstat, which is what makes a planted symlink -type l rather than
# whatever it points at. This runs unconditionally: a directory that is 0700
# today can still hold 0644 files written by an earlier version.
clean_leaf_dir() {
  find "$1" -mindepth 1 -maxdepth 1 ! -type f -exec rm -rf -- {} + 2>/dev/null || true
  find "$1" -mindepth 1 -maxdepth 1 -type f -exec chmod 600 -- {} + 2>/dev/null || true
}

ensure_dirs() {
  # The parent is only checked and re-moded, never swept: its entries are the
  # three directories below it.
  local dir
  for dir in "$STATE_DIR" "$ALARM_DIR" "$RING_DIR" "$CARD_DIR"; do harden_dir "$dir" || exit 1; done
  clean_leaf_dir "$ALARM_DIR"
  clean_leaf_dir "$RING_DIR"
  clean_leaf_dir "$CARD_DIR"
  find "$CARD_DIR" -mindepth 1 -maxdepth 1 -type f -mmin +1500 -delete 2>/dev/null || true
}

# Read a state file through one descriptor that refuses to follow a symlink and
# refuses to block on a FIFO, capped at one byte over the limit so an oversized
# file is detected rather than silently truncated into something that still
# parses. `cat` and `jq file` would do neither.
read_state() {
  local out
  out=$(dd if="$1" iflag=nofollow,nonblock,count_bytes,fullblock \
        bs=4096 count=$((MAX_STATE_BYTES + 1)) status=none 2>/dev/null) || return 1
  [[ -n $out ]] && ((${#out} <= MAX_STATE_BYTES)) || return 1
  printf '%s' "$out"
}

# Publish through an exclusive temporary in the destination directory, created
# 0600 by the umask, then renamed. rename(2) replaces a symlink sitting at the
# destination instead of writing through it, which a plain `>` would do.
write_state() {
  local dest="$1" payload="$2" tmp
  tmp=$(umask 077; mktemp -p "$(dirname -- "$dest")" .nag.XXXXXXXXXX) || return 1
  if ! { printf '%s\n' "$payload" >"$tmp" && mv -f -T -- "$tmp" "$dest"; }; then
    rm -f -- "$tmp"
    return 1
  fi
}

# Trim, collapse whitespace, drop control characters, and cap the length. The
# result reaches a notification headline and a Text element, so newlines and
# escapes have no business surviving.
clean_text() {
  local text
  text=$(printf '%s' "$1" | tr -d '\000-\037\177' | sed -e 's/[[:space:]]\+/ /g' -e 's/^ //' -e 's/ $//')
  printf '%s' "${text:0:$2}"
}

# Strip what a markup-capable sink would act on, plus control characters, and
# cap the length. Notification summaries and bodies are rendered by components
# this plugin cannot pin to plain text, and the message is whatever somebody
# typed.
strip_markup() {
  local text=${1//[<>&]/ }
  # A message reaches omarchy-notification-send as a positional, and that
  # parser reads a leading dash as an option: a message of "-u" is taken as the
  # urgency flag and the notification never appears. Nothing is quoted away
  # here, the dashes are simply not part of what somebody meant to say.
  while [[ $text == -* ]]; do text=${text#-}; done
  clean_text "$text" "$MAX_MESSAGE"
}

# A message made safe for a notification headline, "Alarm" when there is none.
headline() {
  local text
  text=$(strip_markup "$1")
  printf '%s' "${text:-Alarm}"
}

# Tell the bar widget to re-read the list now, rather than leaving it to show a
# stale countdown until its next poll. Silent and best-effort: the shell may not
# be running, and this is a nicety, not a step the command depends on.
refresh_panel() {
  omarchy-shell -q jankeesvw.nag refresh >/dev/null 2>&1 || true
}

# Alarm ids are generated here and never come from anywhere else, but they
# arrive back as arguments to cancel/snooze/fire, so they are checked on the way
# in: an id becomes a systemd unit name and a file path.
valid_id() { [[ $1 =~ ^[0-9]{10,}-[0-9]{1,6}$ ]]; }

new_id() { printf '%s-%s' "$(date +%s)" "$RANDOM"; }

format_remaining() {
  local seconds=$1
  ((seconds < 0)) && seconds=0
  local days=$((seconds / 86400)) hours=$(((seconds % 86400) / 3600)) minutes=$(((seconds % 3600) / 60))

  if ((days > 0)); then
    printf '%dd %dh' "$days" "$hours"
  elif ((hours > 0)); then
    printf '%dh %02dm' "$hours" "$minutes"
  elif ((minutes > 0)); then
    printf '%dm' "$minutes"
  else
    printf '%ds' $((seconds % 60))
  fi
}

# An alarm as the panel reads it. The moment comes twice: as a label for the
# list ("15:15", "tomorrow 09:00", "Wed 18:15", a date beyond the week) and as
# a phrase for the tooltip ("Tea at 11:25", "Dentist tomorrow at 09:00"). The
# "at" has to move around the day word instead of sitting in front of it, which
# is why the phrase is made here and not by concatenation at the other end.
#
# A repeating alarm reads as its rule instead ("Standup every Friday at
# 15:00"), with a short repeatLabel for the list row. `spec` is the alarm as
# text the field takes back, for editing it. `relative` says it was set as a
# duration, "5m tea", so the row leads with the countdown rather than the time,
# and editing it starts from what is left rather than from a clock time.
# `skipped` says a repeat waits past its next occurrence, so it can be undone.
alarm_json() {
  local id=$1 at=$2 message=$3 repeat=${4:-null} relative=${5:-false} now day label phrase spec natural skipped=false
  now=$(date +%s)
  if [[ $repeat != null ]] && natural=$(next_occurrence "$repeat" "$now") && ((at > natural)); then
    skipped=true
  fi
  day=$(date -d "@$at" +%F)
  if [[ $day == "$(date +%F)" ]]; then
    label='%H:%M' phrase='at %H:%M' spec='%H:%M'
  elif [[ $day == "$(date -d tomorrow +%F)" ]]; then
    label='tomorrow %H:%M' phrase='tomorrow at %H:%M' spec='tomorrow %H:%M'
  elif ((at - now < 604800)); then
    label='%a %H:%M' phrase='%A at %H:%M' spec='%a %H:%M'
  else
    label='%-d %b %H:%M' phrase='on %-d %B at %H:%M' spec='%F %H:%M'
  fi
  jq -cn --arg id "$id" --argjson at "$at" --arg message "$message" \
    --arg atLabel "$(date -d "@$at" "+$label")" \
    --arg atPhrase "$(date -d "@$at" "+$phrase")" \
    --arg spec "$(if [[ $relative == true ]]; then duration_spec $((at - now)); else date -d "@$at" "+$spec"; fi)" \
    --arg remaining "$(format_remaining $((at - now)))" \
    --argjson remainingSeconds $((at - now)) \
    --argjson repeat "$repeat" --argjson relative "$relative" --argjson skipped "$skipped" '
    def short: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    def long: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    def ordinal: tostring as $n |
      if (. % 100) >= 11 and (. % 100) <= 13 then $n + "th"
      elif . % 10 == 1 then $n + "st" elif . % 10 == 2 then $n + "nd" elif . % 10 == 3 then $n + "rd"
      else $n + "th" end;
    def unit($n; $one): if $n == 1 then $one else ($n | tostring) + " " + $one + "s" end;
    # 300 -> "5m", 5400 -> "1h30m", the way the field takes it back.
    def compact: [(. / 3600 | floor | select(. > 0) | tostring + "h"),
        (. % 3600 / 60 | floor | select(. > 0) | tostring + "m"),
        (. % 60 | select(. > 0) | tostring + "s")] | join("");
    # [phrase, list label, the words the field takes back]
    def words: if .interval then .interval as $s |
        ["every " + (if $s % 3600 == 0 then unit($s / 3600; "hour")
          elif $s % 60 == 0 then unit($s / 60; "minute") else unit($s; "second") end),
         ($s | compact), "every " + ($s | compact)]
      elif .everyDays then .everyDays as $n |
        ["every " + (if $n % 7 == 0 then unit($n / 7; "week") else unit($n; "day") end),
         ($n | tostring) + "d", "every " + ($n | tostring) + "d"]
      elif .monthday then
        ["every month on the " + (.monthday | ordinal), "monthly", "monthly " + (.monthday | tostring)]
      else .days as $d | ($d | map(tostring) | join(",")) as $key |
      if $key == "1,2,3,4,5,6,7" then ["every day", "daily", "every day"]
      elif $key == "1,2,3,4,5" then ["every weekday", "weekdays", "every weekday"]
      elif $key == "6,7" then ["every weekend", "weekends", "every weekend"]
      # One day out of the week or of the weekdays reads as the exception.
      elif ($d | length) == 6 then ([range(1; 8)] - $d)[0] as $x |
        ["every day except " + long[$x - 1], "daily", "every day except " + (short[$x - 1] | ascii_downcase)]
      elif ($d | length) == 4 and ($d | all(. <= 5)) then ([range(1; 6)] - $d)[0] as $x |
        ["every weekday except " + long[$x - 1], "weekdays", "every weekday except " + (short[$x - 1] | ascii_downcase)]
      elif ($d | length) == 1 then ["every " + long[$d[0] - 1], short[$d[0] - 1], "every " + (short[$d[0] - 1] | ascii_downcase)]
      else ["every " + ($d[:-1] | map(short[. - 1]) | join(", ")) + " and " + short[$d[-1] - 1],
            ($d | map(short[. - 1]) | join(" ")), "every " + ($d | map(short[. - 1] | ascii_downcase) | join(","))]
      end end;
    def text: map(select(. != "")) | join(" ");
    {id: $id, at: $at, message: $message, atLabel: $atLabel, atPhrase: $atPhrase,
     remaining: $remaining, remainingSeconds: $remainingSeconds, ringing: false,
     repeat: null, repeatLabel: null, relative: $relative, spec: ([$spec, $message] | text)}
    + if $repeat then ($repeat | words) as $w |
        {repeat: $repeat, repeatLabel: $w[1], skipped: $skipped,
         atPhrase: ([$w[0], ($repeat.time // empty | "at " + .)] | join(" ")),
         spec: ([$w[2], $repeat.time // "", $message] | text)}
        # An interval counts down like a duration does, since that is how it
        # was typed.
        + if $repeat.interval then {relative: true} else {} end
      else {} end'
}

# The answer to set, parse and snooze: the alarm, marked ok.
ok_alarm() { alarm_json "$@" | jq -c '{ok: true} + .'; }

# The answer to list, from alarms on stdin one per line: anything ringing goes
# on the front, because it is the only thing in the panel that is waiting on an
# answer, then the rest by time.
list_json() {
  jq -sc '(map(select(.ringing)) | sort_by(.at)) + (map(select(.ringing | not)) | sort_by(.at))
    | {ok: true, count: length, ringingCount: (map(select(.ringing)) | length),
       next: (map(select(.ringing | not)) | first), alarms: .}'
}

# ---------------------------------------------------------------------------
# demo mode
# ---------------------------------------------------------------------------

# Demo mode exists so a screenshot is reproducible and shows nothing of yours.
# It is a separate set of alarms rather than a filter over the real ones, so
# nothing that runs while it is on can touch a real alarm: every write returns
# without doing anything, and `list` answers from a fixed script.
demo_on() { [[ -f $DEMO_FILE ]]; }

# Fixed offsets from now rather than fixed clock times, so the countdowns are
# always sensible and the same shot can be retaken in a year.
demo_list() {
  local now
  now=$(date +%s)
  {
    alarm_json 0000000000-1 $((now + 18420)) "pick up the kids"
    alarm_json 0000000000-2 $((now + 205200)) "hockey practice"
    alarm_json 0000000000-3 $((now + 79200)) "dentist"
  } | list_json
}

# The start of every command that changes an alarm. While the demo is on it
# answers for the command and stops there, so a click during a shoot cannot
# tick away something real.
begin_write() {
  ensure_dirs
  if demo_on; then
    ok_json '{ok: true, demo: true}'
    exit 0
  fi
}

# What is left, as text the field takes back: "36s", "5m", "2h 23m",
# "1d 2h 5m". Minutes round up, so an alarm set for 5m and opened for editing
# a moment later still reads 5m rather than 4m.
duration_spec() {
  local seconds=$1
  ((seconds < 1)) && seconds=1
  if ((seconds < 60)); then
    printf '%ds' "$seconds"
    return
  fi
  local minutes=$(((seconds + 59) / 60)) parts=()
  ((minutes >= 1440)) && parts+=("$((minutes / 1440))d")
  ((minutes % 1440 >= 60)) && parts+=("$((minutes % 1440 / 60))h")
  ((minutes % 60)) && parts+=("$((minutes % 60))m")
  printf '%s' "${parts[*]}"
}

# ---------------------------------------------------------------------------
# time parsing
# ---------------------------------------------------------------------------

# Durations from now: 5, 5m, 90s, 2h, 1h30, 1h30m, 2d, 1w, and the spelled-out
# forms. A bare number is minutes, which is what the built-in reminder takes.
# Prints seconds, or fails.
parse_duration() {
  local rest
  rest=$(printf '%s' "${1,,}" | tr -d ' ')
  [[ -z $rest ]] && return 1

  local total=0 num unit
  while [[ -n $rest ]]; do
    [[ $rest =~ ^([0-9]+)(seconds|second|secs|sec|s|minutes|minute|mins|min|m|hours|hour|hrs|hr|h|uur|u|days|day|d|weeks|week|w)?(.*)$ ]] || return 1
    num=${BASH_REMATCH[1]} unit=${BASH_REMATCH[2]} rest=${BASH_REMATCH[3]}

    # Guard the multiplication rather than the input: a 12-digit number of
    # weeks would otherwise overflow into a negative timestamp.
    ((${#num} > 7)) && return 1
    num=$((10#$num))

    case $unit in
      s | sec | secs | second | seconds) total=$((total + num)) ;;
      h | hr | hrs | hour | hours | u | uur) total=$((total + num * 3600)) ;;
      d | day | days) total=$((total + num * 86400)) ;;
      w | week | weeks) total=$((total + num * 604800)) ;;
      # No unit means minutes, so both "5" and the 30 in "1h30" land here.
      *) total=$((total + num * 60)) ;;
    esac
  done

  ((total > 0)) || return 1
  printf '%d' "$total"
}

# Resolve one candidate time spec to an absolute epoch, or fail. Duration first,
# because `date -d` reads "5" as a year and "1h30" as nothing at all.
resolve_spec() {
  local spec="$1" now seconds at
  now=$(date +%s)

  if seconds=$(parse_duration "$spec"); then
    printf '%d' $((now + seconds))
    return 0
  fi

  # GNU date handles the absolute half: "15:15", "9pm", "tomorrow 9:00",
  # "wed 18:15", "next monday 8:00", "dec 25 9:00". It parses text, it does not
  # evaluate it, so an untrusted spec here is a string and nothing more.
  at=$(date -d "$spec" +%s 2>/dev/null) || return 1
  [[ $at =~ ^-?[0-9]+$ ]] || return 1

  # A clock time that has already gone today means the next one, tomorrow. Only
  # when the spec landed on today: "yesterday 9:00" is a mistake, not a wish.
  if ((at <= now)); then
    [[ $(date -d "@$at" +%F) == "$(date +%F)" ]] || return 1
    at=$((at + 86400))
  fi

  printf '%d' "$at"
}

# ---------------------------------------------------------------------------
# recurrence
# ---------------------------------------------------------------------------

# A repeat is a set of ISO weekdays (1 Monday .. 7 Sunday) and a clock time,
# stored with the alarm as {"days": [1, 2, 3, 4, 5], "time": "17:00"}, or a
# day of the month and a clock time, {"monthday": 31, "time": "09:00"}. A
# month without that day gets its last day instead, and the month after is
# back on the 31st: the day asked for is what is kept, never the day used. Each
# occurrence is an ordinary one-shot alarm, and firing one sets the next: the
# series is never a timer of its own, so a snooze, a dismiss or a skip acts on
# one occurrence and cannot move the others.
#
# Two more kinds count from a start instead of naming days: an interval under a
# day, {"interval": 300, "from": <epoch it was set>}, rings every so many
# seconds after it; and {"everyDays": 2, "from": "2026-11-25", "time": "09:00"}
# rings at that time every so many days from that date.

day_number() {
  case ${1,,} in
    mon | monday | mondays) echo 1 ;;
    tue | tues | tuesday | tuesdays) echo 2 ;;
    wed | weds | wednesday | wednesdays) echo 3 ;;
    thu | thur | thurs | thursday | thursdays) echo 4 ;;
    fri | friday | fridays) echo 5 ;;
    sat | saturday | saturdays) echo 6 ;;
    sun | sunday | sundays) echo 7 ;;
    *) return 1 ;;
  esac
}

# The weekdays one word names, "fri", "weekdays", "mon-fri", or fail.
day_set() {
  local word=${1,,} from to day range=()
  case $word in
    day | days | daily) echo 1 2 3 4 5 6 7 ;;
    weekday | weekdays | workday | workdays) echo 1 2 3 4 5 ;;
    weekend | weekends) echo 6 7 ;;
    ?*-?*)
      from=$(day_number "${word%%-*}") && to=$(day_number "${word#*-}") || return 1
      for ((day = from; ; day = day % 7 + 1)); do
        range+=("$day")
        ((day == to)) && break
      done
      echo "${range[*]}"
      ;;
    *) day_number "$word" ;;
  esac
}

# A clock time as HH:MM: "15:00", "9am", "9:30pm", or a bare hour, "15".
clock_time() {
  local word=${1,,}
  [[ $word =~ ^[0-9]{1,2}(:[0-9]{2})?(am|pm)?$ ]] || return 1
  if [[ $word =~ ^[0-9]+$ ]]; then
    ((10#$word < 24)) || return 1
    word="$((10#$word)):00"
  fi
  date -d "today $word" +%H:%M 2>/dev/null
}

# The day words at the start of the arguments, alone or in lists: "mon, wed
# and fri", "mon,wed,fri", "weekdays". Prints how many words they took, then
# the ISO weekdays they name.
day_words() {
  local -a parts
  local word part set count=0 days=""
  for word in "$@"; do
    word=${word,,}
    if [[ $word == and ]]; then count=$((count + 1)); continue; fi
    IFS=, read -r -a parts <<<"${word%,}"
    ((${#parts[@]})) || break
    set=""
    for part in "${parts[@]}"; do
      set+=" $(day_set "$part")" || { set=""; break; }
    done
    [[ -n $set ]] || break
    days+=$set
    count=$((count + 1))
  done
  echo "$count$days"
}

# The interval after "every": "5m", "30s", "1h30", "2d", or a number and its
# unit in two words, "2 days", "5 min". Sets INTERVAL to seconds and
# INTERVAL_WORDS to the words it took, or fails.
interval_of() {
  local first=${1:-} second=${2:-}
  [[ $first =~ ^[0-9] ]] || return 1
  if [[ $first =~ ^[0-9]+$ && ${second,,} =~ ^[a-z]+$ ]] && INTERVAL=$(parse_duration "$first$second"); then
    INTERVAL_WORDS=2
  elif INTERVAL=$(parse_duration "$first"); then
    INTERVAL_WORDS=1
  else
    return 1
  fi
}

# "every fri 15:00 standup", "every weekday at 17 leave", "daily 9:00 water",
# "every mon, wed and fri 7:30 run", "17:00 every weekday leave",
# "monthly 15 9:00 rent", "every month on the 1st at 8 pay",
# "every 5m water", "every 2 days 9:00 plants". The keyword
# is what makes it a repeat: "fri 15:00" alone is still next Friday, once, and
# a time is required, because a repeat at a guessed hour is one you sleep
# through; only an interval under a day, which counts from now, goes without
# one. A monthly repeat without a day takes today's; a bare number after
# "monthly" is the day only when a time follows it, and "monthly 15 rent" is
# refused: the 15th or 15:00 is a guess, and a wrong one rings on the wrong
# day.
#
# Sets PARSED_AT, PARSED_MESSAGE and PARSED_REPEAT, or fails.
parse_repeat() {
  local -a words=("$@") days=() parts
  local i=0 time="" word part set monthday="" number every_days="" now from INTERVAL INTERVAL_WORDS

  # The time may come first.
  if time=$(clock_time "${words[0]:-}"); then i=1; else time=""; fi
  word=${words[i]:-}
  case ${word,,} in
    every | each)
      i=$((i + 1))
      word=${words[i]:-}
      if [[ ${word,,} == month ]]; then
        i=$((i + 1)) monthday=today
      elif interval_of "$word" "${words[i + 1]:-}"; then
        i=$((i + INTERVAL_WORDS))
        if ((INTERVAL % 86400 == 0)); then
          # "every 2 days 9:00": whole days, at a time, which is required for
          # the same reason as any other repeat.
          every_days=$((INTERVAL / 86400))
        else
          # "every 5m water": from now, no clock time. A time with it would be
          # a start the interval cannot keep, so it is refused rather than
          # read into the message.
          ((INTERVAL >= MIN_INTERVAL && INTERVAL < 86400)) && [[ -z $time ]] || return 1
          word=${words[i]:-}
          [[ ${word,,} == at ]] && word=${words[i + 1]:-}
          ! clock_time "$word" >/dev/null || return 1
          now=$(date +%s)
          PARSED_REPEAT=$(jq -cn --argjson every "$INTERVAL" --argjson from "$now" '{interval: $every, from: $from}')
          PARSED_AT=$((now + INTERVAL))
          PARSED_MESSAGE=$(clean_text "${words[*]:i}" "$MAX_MESSAGE")
          return 0
        fi
      fi
      ;;
    monthly) i=$((i + 1)) monthday=today ;;
    daily | weekdays | workdays | weekends) ;;
    *) return 1 ;;
  esac

  if [[ -n $monthday ]]; then
    # "on the 15th", "15th", "15", or nothing for today's day.
    word=${words[i]:-}
    [[ ${word,,} == on ]] && i=$((i + 1))
    word=${words[i]:-}
    [[ ${word,,} == the ]] && i=$((i + 1))
    word=${words[i],,}
    word=${word:-} number=${word%%[a-z]*}
    if [[ $word =~ ^[0-9]{1,2}(st|nd|rd|th)$ ]] ||
      { [[ $word =~ ^[0-9]{1,2}$ ]] &&
        { [[ -n $time ]] || [[ ${words[i + 1],,} == at ]] || clock_time "${words[i + 1]:-}" >/dev/null; }; }; then
      monthday=$((10#$number))
      ((monthday >= 1 && monthday <= 31)) || return 1
      i=$((i + 1))
    elif [[ $word =~ ^[0-9]{1,2}$ && -z $time ]]; then
      return 1
    else
      monthday=$((10#$(date +%d)))
    fi
  fi

  if [[ -z $monthday$every_days ]]; then
    read -r -a parts <<<"$(day_words "${words[@]:i}")"
    i=$((i + parts[0]))
    days=("${parts[@]:1}")

    # "every weekday except wed", "every day except sat and sun": only after
    # every day or every weekday, the two sets a day is taken out of.
    word=${words[i]:-}
    if [[ ${word,,} == except ]]; then
      set=" $(printf '%s\n' "${days[@]}" | sort -nu | tr '\n' ' ')"
      [[ $set == " 1 2 3 4 5 6 7 " || $set == " 1 2 3 4 5 " ]] || return 1
      read -r -a parts <<<"$(day_words "${words[@]:i+1}")"
      ((${#parts[@]} > 1)) || return 1
      i=$((i + 1 + parts[0]))
      for part in "${parts[@]:1}"; do set=${set// $part / }; done
      read -r -a days <<<"$set"
    fi
  fi
  [[ -n $monthday$every_days ]] || ((${#days[@]})) || return 1

  if [[ -z $time ]]; then
    word=${words[i]:-}
    [[ ${word,,} == at ]] && i=$((i + 1))
    time=$(clock_time "${words[i]:-}") || return 1
    i=$((i + 1))
    # "9:30 pm", in two words.
    word=${words[i]:-}
    if [[ ${word,,} == am || ${word,,} == pm ]]; then
      time=$(clock_time "${words[i - 1]}$word") || return 1
      i=$((i + 1))
    fi
  fi

  if [[ $every_days == 1 ]]; then
    PARSED_REPEAT=$(jq -cn --arg time "$time" '{days: [1, 2, 3, 4, 5, 6, 7], time: $time}')
  elif [[ -n $every_days ]]; then
    # The series counts from its first day: today if the time is still ahead,
    # tomorrow otherwise.
    from=$(date +%F)
    (($(date -d "$from $time" +%s) > $(date +%s))) || from=$(date -d tomorrow +%F)
    PARSED_REPEAT=$(jq -cn --argjson every "$every_days" --arg from "$from" --arg time "$time" \
      '{everyDays: $every, from: $from, time: $time}')
  elif [[ -n $monthday ]]; then
    PARSED_REPEAT=$(jq -cn --argjson day "$monthday" --arg time "$time" '{monthday: $day, time: $time}')
  else
    PARSED_REPEAT=$(printf '%s\n' "${days[@]}" | sort -nu |
      jq -sc --arg time "$time" '{days: ., time: $time}')
  fi
  PARSED_AT=$(next_occurrence "$PARSED_REPEAT" "$(date +%s)") || return 1
  PARSED_MESSAGE=$(clean_text "${words[*]:i}" "$MAX_MESSAGE")
}

# The first moment after the epoch in $2 that the repeat in $1 names. Day by
# day rather than by adding a week of seconds, so a DST change cannot shift
# the hour; a time that does not exist on a day (02:30 on the spring change)
# skips that day.
next_occurrence() {
  local repeat=$1 after=$2 time days i day at
  case $(jq -r 'if .interval then "interval" elif .everyDays then "days" elif .monthday then "month" else "" end' <<<"$repeat") in
    interval) interval_occurrence "$repeat" "$after" +; return ;;
    days) days_occurrence "$repeat" "$after" +; return ;;
    month) month_occurrence "$repeat" "$after" +; return ;;
  esac
  time=$(jq -r '.time' <<<"$repeat")
  days=" $(jq -r '.days | map(tostring) | join(" ")' <<<"$repeat") "
  for ((i = 0; i <= 7; i++)); do
    day=$(date -d "$(date -d "@$after" +%F) +$i day" +%F)
    at=$(date -d "$day $time" +%s 2>/dev/null) || continue
    if ((at > after)) && [[ $days == *" $(date -d "@$at" +%u) "* ]]; then
      printf '%d' "$at"
      return 0
    fi
  done
  return 1
}

# The last moment before the epoch in $2 that the repeat in $1 names, the way
# back from next_occurrence.
previous_occurrence() {
  local repeat=$1 before=$2 time days i day at
  case $(jq -r 'if .interval then "interval" elif .everyDays then "days" elif .monthday then "month" else "" end' <<<"$repeat") in
    interval) interval_occurrence "$repeat" "$before" -; return ;;
    days) days_occurrence "$repeat" "$before" -; return ;;
    month) month_occurrence "$repeat" "$before" -; return ;;
  esac
  time=$(jq -r '.time' <<<"$repeat")
  days=" $(jq -r '.days | map(tostring) | join(" ")' <<<"$repeat") "
  for ((i = 0; i <= 7; i++)); do
    day=$(date -d "$(date -d "@$before" +%F) -$i day" +%F)
    at=$(date -d "$day $time" +%s 2>/dev/null) || continue
    if ((at < before)) && [[ $days == *" $(date -d "@$at" +%u) "* ]]; then
      printf '%d' "$at"
      return 0
    fi
  done
  return 1
}

# next_occurrence and previous_occurrence for a monthly repeat: the first
# moment after (+) or the last before (-) the epoch in $2, month by month from
# the one it falls in. Each month gets the day asked for, or its last day when
# it is shorter, so a 31st rings on 28 February and on 31 March.
month_occurrence() {
  local repeat=$1 from=$2 way=$3 time monthday first i month last day at
  time=$(jq -r '.time' <<<"$repeat")
  monthday=$(jq -r '.monthday' <<<"$repeat")
  first=$(date -d "@$from" +%Y-%m-01)
  for ((i = 0; i <= 13; i++)); do
    month=$(date -d "$first $way$i month" +%Y-%m-01)
    last=$(date -d "$month +1 month -1 day" +%-d)
    day=$((monthday < last ? monthday : last))
    at=$(date -d "${month%-01}-$(printf '%02d' "$day") $time" +%s 2>/dev/null) || continue
    if { [[ $way == + ]] && ((at > from)); } || { [[ $way == - ]] && ((at < from)); }; then
      printf '%d' "$at"
      return 0
    fi
  done
  return 1
}

# The same for an interval: occurrences are its start plus a whole number of
# intervals, the first one interval after the start.
interval_occurrence() {
  local repeat=$1 from=$2 way=$3 every start k
  every=$(jq -r '.interval' <<<"$repeat")
  start=$(jq -r '.from' <<<"$repeat")
  [[ $every =~ ^[0-9]+$ && $start =~ ^[0-9]+$ ]] && ((every > 0)) || return 1
  if [[ $way == + ]]; then
    k=$(((from - start) / every + 1))
    ((k >= 1)) || k=1
  else
    ((from - start > every)) || return 1
    k=$(((from - start - 1) / every))
  fi
  printf '%d' $((start + k * every))
}

# And for every so many days: the days counted from its first one, at its
# time. Days are counted in UTC dates so a DST change cannot shift one, and a
# time that does not exist on a day skips that day.
days_occurrence() {
  local repeat=$1 from=$2 way=$3 every start start_day time day offset i at
  every=$(jq -r '.everyDays' <<<"$repeat")
  start=$(jq -r '.from' <<<"$repeat")
  time=$(jq -r '.time' <<<"$repeat")
  [[ $every =~ ^[0-9]+$ && $start =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && ((every > 0)) || return 1
  day=$(date -ud "$(date -d "@$from" +%F)" +%s)
  start_day=$(date -ud "$start" +%s 2>/dev/null) || return 1
  offset=$(((day - start_day) / 86400))
  if [[ $way == + ]]; then
    ((offset < 0)) && offset=0
    offset=$(((offset + every - 1) / every * every))
  else
    ((offset >= 0)) || return 1
    offset=$((offset / every * every))
  fi
  for ((i = 0; i <= 2; i++)); do
    ((offset >= 0)) || return 1
    day=$(date -d "$start +$offset day" +%F 2>/dev/null) || return 1
    at=$(date -d "$day $time" +%s 2>/dev/null) || at=""
    if [[ -n $at ]] && { { [[ $way == + ]] && ((at > from)); } || { [[ $way == - ]] && ((at < from)); }; }; then
      printf '%d' "$at"
      return 0
    fi
    if [[ $way == + ]]; then offset=$((offset + every)); else offset=$((offset - every)); fi
  done
  return 1
}

# Split "15:15 pick up the kids" into a time and a message by trying the longest
# leading run of words that resolves, down to one. Longest first is what lets
# "tomorrow 9:00 dentist" and "next wednesday 18:15 hockey" work without the
# message having to be quoted. A repeat is tried first.
#
# Sets PARSED_AT, PARSED_MESSAGE, PARSED_REPEAT ("null" for a one-shot) and
# PARSED_RELATIVE ("true" when the time was a duration).
parse_input() {
  local -a words
  read -r -a words <<<"$(clean_text "$*" "$MAX_SPEC")"
  PARSED_REPEAT=null PARSED_RELATIVE=false
  ((${#words[@]})) && parse_repeat "${words[@]}" && return 0
  PARSED_REPEAT=null
  local count=${#words[@]} n at
  for ((n = count < 4 ? count : 4; n >= 1; n--)); do
    if at=$(resolve_spec "${words[*]:0:n}"); then
      PARSED_AT=$at
      parse_duration "${words[*]:0:n}" >/dev/null && PARSED_RELATIVE=true
      PARSED_MESSAGE=$(clean_text "${words[*]:n}" "$MAX_MESSAGE")
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# alarm state
# ---------------------------------------------------------------------------

# Write an alarm to disk and arm its systemd timer, or fail and leave nothing.
schedule() {
  local id=$1 at=$2 message=$3 repeat=${4:-null} relative=${5:-false}
  write_state "$ALARM_DIR/$id.json" "$(jq -cn --arg id "$id" --argjson at "$at" \
    --arg message "$message" --argjson repeat "$repeat" --argjson created "$(date +%s)" \
    --argjson relative "$relative" \
    '{id: $id, at: $at, message: $message, created: $created}
     + if $repeat then {repeat: $repeat} else {} end
     + if $relative then {relative: true} else {} end')" || return 1
  arm_timer "$id" "$at" || { rm -f -- "$ALARM_DIR/$id.json"; return 1; }
}

# The occurrence of a repeat that comes after the epoch in $2, as a new alarm.
schedule_next() {
  local repeat=$1 after=$2 message=$3 at
  at=$(next_occurrence "$repeat" "$after") && schedule "$(new_id)" "$at" "$message" "$repeat"
}

# Sets ALARM_ID, ALARM_AT, ALARM_MESSAGE, ALARM_REPEAT and ALARM_RELATIVE from an alarm or
# ringing file, or fails on one that is not a bounded, well-shaped document.
# The fields are split on the unit separator, which clean_text never lets
# into a message.
load_alarm() {
  local fields
  fields=$(read_state "$1" | jq -er 'select(type == "object")
    | [.id, .at, .message // "", (.repeat // null | tojson), .relative == true]
    | map(tostring) | join([31] | implode)' 2>/dev/null) || return 1
  IFS=$'\x1f' read -r ALARM_ID ALARM_AT ALARM_MESSAGE ALARM_REPEAT ALARM_RELATIVE <<<"$fields"
  valid_id "$ALARM_ID" && [[ $ALARM_AT =~ ^[0-9]+$ ]]
}

# Arm the systemd timer for an alarm that is already on disk.
arm_timer() {
  systemd-run --user --quiet --collect \
    --unit="nag-$1" \
    --on-calendar="$(date -d "@$2" '+%Y-%m-%d %H:%M:%S')" \
    --timer-property=AccuracySec=1s \
    -- "$SELF" fire "$1" >/dev/null 2>&1
}

# Whether the alarm's timer, or the unit ringing it, is loaded.
unit_exists() {
  systemctl --user list-units --all --no-legend --plain "nag-$1.timer" "nag-$1.service" 2>/dev/null | grep -q .
}

# Every pending alarm on disk, one per line. Re-arms any whose timer is
# missing: a reboot clears transient units but not the files, so this is what
# makes an alarm for tomorrow morning real.
pending_alarms() {
  local now file ALARM_ID ALARM_AT ALARM_MESSAGE ALARM_REPEAT ALARM_RELATIVE
  now=$(date +%s)
  for file in "$ALARM_DIR"/*.json; do
    # A file we cannot read as one bounded, regular, well-shaped document is
    # dropped rather than repaired. Losing an alarm is the honest outcome for
    # state that is no longer ours to trust.
    load_alarm "$file" || { rm -f -- "$file"; continue; }

    if ((ALARM_AT <= now)); then
      # Its timer is going off right now, or it already rings.
      unit_exists "$ALARM_ID" || [[ -f $RING_DIR/$ALARM_ID.json ]] ||
        overdue "$ALARM_ID" "$ALARM_AT" "$ALARM_MESSAGE" "$ALARM_REPEAT"
      continue
    fi

    unit_exists "$ALARM_ID" || arm_timer "$ALARM_ID" "$ALARM_AT"
    alarm_json "$ALARM_ID" "$ALARM_AT" "$ALARM_MESSAGE" "$ALARM_REPEAT" "$ALARM_RELATIVE"
  done
}

# An alarm whose time went by with no timer left to ring it: the machine was
# off. Within the ringing window it still rings, late; past it, it is reported
# missed, so it never just disappears. A repeat moves on to its next
# occurrence from now, however many it slept through.
overdue() {
  local id=$1 at=$2 message=$3 repeat=$4 now next new
  now=$(date +%s)
  if ((now - at < $(ring_minutes) * 60)) &&
    systemd-run --user --quiet --collect --unit="nag-$id" -- "$SELF" fire "$id" >/dev/null 2>&1; then
    return 0
  fi
  rm -f -- "$ALARM_DIR/$id.json"
  notify_missed "$message" "$at"
  if [[ $repeat != null ]] && next=$(next_occurrence "$repeat" "$now"); then
    new=$(new_id)
    if schedule "$new" "$next" "$message" "$repeat"; then alarm_json "$new" "$next" "$message" "$repeat"; fi
  fi
}

# Every ringing alarm, one per line.
ringing_alarms() {
  local file raw
  for file in "$RING_DIR"/*.json; do
    raw=$(read_state "$file") && jq -ce 'select(type == "object" and has("id"))
      | . + {ringing: true, remaining: "now", remainingSeconds: 0, atPhrase: ("at " + (.atLabel // ""))}' \
      <<<"$raw" 2>/dev/null || rm -f -- "$file"
  done
}

cancel_alarm() {
  local id=$1
  systemctl --user stop "nag-$id.timer" >/dev/null 2>&1 || true
  systemctl --user stop "nag-$id.service" >/dev/null 2>&1 || true
  rm -f -- "$ALARM_DIR/$id.json" "$RING_DIR/$id.json"
}

# ---------------------------------------------------------------------------
# ringing
# ---------------------------------------------------------------------------

# The notification of a ringing alarm, its id left in RING_NID. The summary and
# body are rendered by components this plugin does not own, and the summary is
# whatever somebody typed into the field, so it goes through headline().
notify_ringing() {
  local id=$1 message=$2 when=$3 replace=()
  [[ -n ${4:-} ]] && replace=(-r "$4")
  # The buttons answer the alarm without opening the panel; clicking the card
  # runs the first, so it snoozes. Their words are constants and the id goes
  # after --with, so the message never reaches a command. With snooze off,
  # dismiss is the only answer left, so the card has no button: clicking it or
  # its X dismisses.
  local answer
  if setting_off snoozeOn; then
    answer=(--exec "$SELF" dismiss "$id")
  else
    answer=(--action "Snooze $(snooze_minutes) min" "$SELF" snooze --action "Dismiss" "$SELF" dismiss --with "$id")
  fi

  RING_NID=""
  if RING_NID=$(omarchy-notification-send "${replace[@]}" -p -u critical -g "$(glyph)" "$(headline "$message")" "$when" \
    "${answer[@]}" 2>/dev/null); then
    if [[ $RING_NID =~ ^[0-9]+$ ]]; then
      watch_close "$id" "$RING_NID" &
      RING_WATCHER=$!
    else
      RING_NID=""
    fi
  else
    RING_NID=""
    # Shells older than Omarchy 4.5 have no --action and get the click-to-open
    # card instead. No close watcher for it: clicking that card opens the panel
    # and closes it with the same reason, which must not dismiss.
    omarchy-notification-send -u critical -g "$(glyph)" "$(headline "$message")" "$when" \
      --exec omarchy-shell shell summon jankeesvw.nag >/dev/null 2>&1 || true
  fi
}

# Closing the alarm's notification (its X, or clearing the deck) dismisses the
# alarm, as the Dismiss button does. The shell closes the card with the same
# reason when a button or the card itself is clicked, so this waits a moment and
# only acts if the alarm is still ringing: a Snooze or Dismiss click has already
# answered it by then, and stopped this unit with it. The dismiss runs in its
# own unit because it stops this one.
watch_close() {
  local id=$1 nid=$2 line
  gdbus monitor --session --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications 2>/dev/null |
    while IFS= read -r line; do
      [[ $line == *".NotificationClosed (uint32 $nid, uint32 2)"* ]] || continue
      sleep 2
      [[ -f $RING_DIR/$id.json ]] &&
        systemd-run --user --quiet --collect -- "$SELF" dismiss "$id" >/dev/null 2>&1
      break
    done
}

# Turn an alarm nobody answered into a missed one: the ringing card in $3 is
# replaced in place when there is one, and a new card is sent otherwise. No
# buttons, since there is nothing left to answer, and critical so it stays
# until closed: a missed alarm whose card expires is missed twice.
notify_missed() {
  local message=$1 at=$2 nid=${3:-} when replace=()
  when=$(date -d "@$at" '+%H:%M')
  [[ $(date -d "@$at" +%F) == "$(date +%F)" ]] || when=$(date -d "@$at" '+%a %-d %b %H:%M')
  [[ -n $nid ]] && replace=(-r "$nid")
  omarchy-notification-send "${replace[@]}" -u critical -g "$(glyph)" \
    "Missed: $(headline "$message")" "$when" >/dev/null 2>&1 || true
}

# The alarm's sound, for as long as the settings say: `soundOn` false is
# silent, `sound` is the file (the freedesktop alarm when unset or unreadable),
# `soundRepeat` false plays it once, and `soundPause` is the seconds of silence
# between two plays.
ring() {
  local id=$1 sound pause
  setting_off soundOn && return 0
  sound=$(widget_setting sound)
  sound=${sound/#\~/$HOME}
  [[ -f $sound && -r $sound ]] || sound=$DEFAULT_SOUND
  [[ -r $sound ]] || return 0

  # Foreground: systemd stops whatever this unit leaves behind when it exits.
  # Repeats until answered, however long that takes: snooze, dismiss and cancel
  # stop this unit.
  if setting_off soundRepeat; then
    pw-play -- "$sound" >/dev/null 2>&1 || true
    return 0
  fi
  pause=$(int_setting soundPause 0 60 0)
  while [[ -f $RING_DIR/$id.json ]]; do
    pw-play -- "$sound" >/dev/null 2>&1 || break
    ((pause == 0)) || sleep "$pause"
  done
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

cmd_parse() {
  local PARSED_AT PARSED_MESSAGE PARSED_REPEAT PARSED_RELATIVE
  parse_input "$@" || die "not a time"
  ok_alarm "" "$PARSED_AT" "$PARSED_MESSAGE" "$PARSED_REPEAT" "$PARSED_RELATIVE"
}

# Schedule what parse_input left in PARSED_*, and answer with it.
schedule_parsed() {
  local id
  id=$(new_id)
  schedule "$id" "$PARSED_AT" "$PARSED_MESSAGE" "$PARSED_REPEAT" "$PARSED_RELATIVE" || die "could not set the timer"
  refresh_panel
  ok_alarm "$id" "$PARSED_AT" "$PARSED_MESSAGE" "$PARSED_REPEAT" "$PARSED_RELATIVE"
}

cmd_set() {
  begin_write
  local alarms=("$ALARM_DIR"/*.json)
  ((${#alarms[@]} < MAX_ALARMS)) || die "too many alarms"

  local PARSED_AT PARSED_MESSAGE PARSED_REPEAT PARSED_RELATIVE
  parse_input "$@" || die "not a time"
  schedule_parsed
}

# Replace an alarm, pending or ringing, with what the text now says. The old
# one goes only once the new text has parsed, so a typo keeps it.
cmd_edit() {
  begin_write
  local id=${1:-}
  shift || true
  valid_id "$id" && [[ -f $ALARM_DIR/$id.json || -f $RING_DIR/$id.json ]] || die "unknown alarm"

  local PARSED_AT PARSED_MESSAGE PARSED_REPEAT PARSED_RELATIVE
  parse_input "$@" || die "not a time"
  cancel_alarm "$id"
  schedule_parsed
}

cmd_list() {
  ensure_dirs
  if demo_on; then demo_list; return; fi
  { ringing_alarms; pending_alarms; } | list_json
}

# Cancel a pending alarm, a whole repeat with it, or stop a ringing one
# without setting a new one.
cmd_cancel() {
  begin_write
  local id=${1:-}
  valid_id "$id" || die "unknown alarm"
  cancel_alarm "$id"
  refresh_panel
  ok_json '{ok: true}'
}

cmd_clear() {
  begin_write
  local file id
  for file in "$ALARM_DIR"/*.json "$RING_DIR"/*.json; do
    id=${file##*/}
    id=${id%.json}
    if valid_id "$id"; then cancel_alarm "$id"; fi
  done
  refresh_panel
  ok_json '{ok: true}'
}

# Put a ringing or pending alarm off by some minutes, as a one-shot: snoozing
# an occurrence of a repeat leaves the next occurrence where it was.
cmd_snooze() {
  begin_write
  local id=${1:-} minutes=${2:-}
  [[ -n $minutes ]] || minutes=$(snooze_minutes)
  valid_id "$id" || die "unknown alarm"
  int_in "$minutes" 1 "$MAX_SNOOZE_MINUTES" || die "bad snooze"

  local ALARM_ID ALARM_AT ALARM_MESSAGE ALARM_REPEAT ALARM_RELATIVE
  load_alarm "$RING_DIR/$id.json" || load_alarm "$ALARM_DIR/$id.json" || die "unknown alarm"
  cancel_alarm "$id"

  local PARSED_AT=$(($(date +%s) + 10#$minutes * 60)) PARSED_MESSAGE=$ALARM_MESSAGE PARSED_REPEAT=null PARSED_RELATIVE=true
  schedule_parsed
}

# Skip the next occurrence of a repeat: it moves on to the one after.
cmd_skip() {
  begin_write
  local id=${1:-}
  valid_id "$id" || die "unknown alarm"

  local ALARM_ID ALARM_AT ALARM_MESSAGE ALARM_REPEAT ALARM_RELATIVE
  load_alarm "$ALARM_DIR/$id.json" || die "unknown alarm"
  [[ $ALARM_REPEAT != null ]] || die "not a repeating alarm"

  local PARSED_AT PARSED_MESSAGE=$ALARM_MESSAGE PARSED_REPEAT=$ALARM_REPEAT PARSED_RELATIVE=false
  PARSED_AT=$(next_occurrence "$ALARM_REPEAT" "$ALARM_AT") || die "no next occurrence"
  cancel_alarm "$id"
  schedule_parsed
}

# Undo one skip of a repeat: it goes back to the occurrence before, never to
# one already past.
cmd_unskip() {
  begin_write
  local id=${1:-}
  valid_id "$id" || die "unknown alarm"

  local ALARM_ID ALARM_AT ALARM_MESSAGE ALARM_REPEAT ALARM_RELATIVE
  load_alarm "$ALARM_DIR/$id.json" || die "unknown alarm"
  [[ $ALARM_REPEAT != null ]] || die "not a repeating alarm"

  local PARSED_AT PARSED_MESSAGE=$ALARM_MESSAGE PARSED_REPEAT=$ALARM_REPEAT PARSED_RELATIVE=false
  local now previous
  now=$(date +%s)
  PARSED_AT=$(next_occurrence "$ALARM_REPEAT" "$now") || die "no next occurrence"
  if previous=$(previous_occurrence "$ALARM_REPEAT" "$ALARM_AT") && ((previous > now)); then
    PARSED_AT=$previous
  fi
  cancel_alarm "$id"
  schedule_parsed
}

# Ask for an alarm through the Omarchy menu overlay, which is the same text
# prompt the rest of the system uses. Meant for a keybinding and for a row in
# the menu: it puts setting an alarm one keystroke away from anywhere, without
# the bar widget having to be open or even visible.
cmd_ask() {
  # The panel is the better prompt, because it reads back what it understood
  # while you are still typing. The menu overlay cannot do that: it hands over
  # one string when you press Enter and there is no way to say anything back
  # before then. So the panel gets first refusal, and the overlay is only for
  # the case where there is no live bar widget to open.
  #
  # summon always exits 0 and says "ok" or "unknown" on stdout, so the answer
  # has to be read rather than the exit code.
  local summoned
  summoned=$(omarchy-shell shell summon jankeesvw.nag 2>/dev/null | head -c 32) || true
  if [[ $summoned == ok* ]]; then
    ok_json '{ok: true, opened: "panel"}'
    return 0
  fi

  command -v omarchy-menu-input >/dev/null 2>&1 || die "omarchy-menu-input is not available"

  local text result
  # A cancelled prompt exits non-zero, and that is not an error worth reporting.
  text=$(omarchy-menu-input "Nag" --width 420) || exit 0
  text=$(clean_text "$text" "$MAX_SPEC")
  [[ -z $text ]] && exit 0
  result=$(cmd_set "$text")

  # The overlay closes the moment you press Enter, so this notification is the
  # only chance to read back what was understood. It says the same sentence the
  # panel puts under its field, for the same reason: it shows where the split
  # between the time and the message landed.
  if [[ $(jq -r '.ok' <<<"$result" 2>/dev/null) == "true" ]]; then
    local message
    message=$(headline "$(jq -r '.message' <<<"$result")")
    omarchy-notification-send -g "$(glyph)" "${message^} $(jq -r '.atPhrase' <<<"$result")" \
      "in $(jq -r '.remaining' <<<"$result")" >/dev/null 2>&1 || true
  else
    # Quote it back: seeing what you actually typed is what tells you which
    # word it choked on.
    omarchy-notification-send -g "$(glyph)" "No time in that" \
      "$(strip_markup "$text")" >/dev/null 2>&1 || true
  fi

  printf '%s\n' "$result"
}

# Run by the systemd timer. Moves the alarm to ringing, where it stays until it
# is dismissed or snoozed, for the ringMinutes setting at most: an alarm that
# clears itself after a few seconds is one you can miss, and one nobody
# answers for that long was missed, which its notification then says.
cmd_fire() {
  ensure_dirs
  demo_on && exit 0
  local id=${1:-} when ALARM_ID ALARM_AT ALARM_MESSAGE ALARM_REPEAT ALARM_RELATIVE
  valid_id "$id" || exit 0
  load_alarm "$ALARM_DIR/$id.json" || exit 0
  when=$(date -d "@$ALARM_AT" '+%H:%M')

  # An occurrence of a repeat takes over from the one before it if that one is
  # still ringing: "every 30s" would otherwise pile up cards and sounds.
  local card="" last_card=""
  if [[ $ALARM_REPEAT != null ]]; then
    supersede "$ALARM_REPEAT" "$ALARM_MESSAGE"
    card=$(card_file "$ALARM_REPEAT" "$ALARM_MESSAGE")
    last_card=$(last_card "$card" "$ALARM_REPEAT")
  fi

  write_state "$RING_DIR/$id.json" "$(jq -cn --arg id "$id" --argjson at "$ALARM_AT" \
    --arg message "$ALARM_MESSAGE" --arg atLabel "$when" --argjson series "$ALARM_REPEAT" \
    '{id: $id, at: $at, message: $message, atLabel: $atLabel}
     + if $series then {series: $series} else {} end')"
  rm -f -- "$ALARM_DIR/$id.json"

  # The next occurrence is set before this one rings, so nothing done to this
  # one can move it. From now if this one fires late, so it is not in the past.
  if [[ $ALARM_REPEAT != null ]]; then
    local now
    now=$(date +%s)
    schedule_next "$ALARM_REPEAT" $((ALARM_AT > now ? ALARM_AT : now)) "$ALARM_MESSAGE" || true
  fi

  local RING_NID RING_WATCHER=""
  notify_ringing "$id" "$ALARM_MESSAGE" "$when" "$last_card"
  if [[ -n $card ]]; then
    if [[ -n $RING_NID ]]; then write_state "$card" "$RING_NID" || true; else rm -f -- "$card"; fi
  fi
  refresh_panel
  ring "$id" &
  local sound=$!

  # A second at a time, counted rather than clocked, until it is answered or
  # its time is up.
  local ticks=$(($(ring_minutes) * 60))
  while [[ -f $RING_DIR/$id.json ]]; do
    if ((ticks-- <= 0)); then
      rm -f -- "$RING_DIR/$id.json"
      notify_missed "$ALARM_MESSAGE" "$ALARM_AT" "$RING_NID"
      refresh_panel
      break
    fi
    sleep 1
  done
  # The sound and the close watcher go with it: a watcher left behind would
  # hold a bus monitor open until the card is closed, which a missed alarm's
  # card may never be.
  local job
  for job in "$sound" $RING_WATCHER; do
    pkill -P "$job" 2>/dev/null || true
    kill "$job" 2>/dev/null || true
  done
  # An alarm taken over by the next occurrence of its repeat leaves its card
  # alone: the new occurrence has already rewritten that card in place.
  # Closing it would only strand it, since the shell keeps a closed card on
  # screen with nothing left to update it.
}

# Where the card of a repeat's latest occurrence is kept, by repeat and message.
card_file() {
  printf '%s\n%s' "$1" "$2" | sha256sum | cut -c1-32 | sed "s|^|$CARD_DIR/|"
}

# The card the occurrence before this one left, ringing or missed, for the new
# one to rewrite in place: one card per repeat, not one per occurrence. Only
# an interval's, and only one recent enough to be that occurrence's: an old id
# may since have gone to another notification.
last_card() {
  local file=$1 every nid age
  every=$(jq -r '.interval // empty' <<<"$2" 2>/dev/null) || return 0
  [[ $every =~ ^[0-9]+$ ]] || return 0
  nid=$(read_state "$file" 2>/dev/null) || return 0
  [[ $nid =~ ^[0-9]+$ ]] || return 0
  age=$(($(date +%s) - $(stat -c %Y -- "$file" 2>/dev/null || echo 0)))
  ((age >= 0 && age <= every + $(ring_minutes) * 60 + 60)) || return 0
  printf '%s\n' "$nid"
}

# Stop the ringing occurrence of the repeat in $1 with the message in $2, if
# there is one: removing its file ends its ring.
supersede() {
  local file raw
  for file in "$RING_DIR"/*.json; do
    raw=$(read_state "$file") || continue
    jq -e --argjson series "$1" --arg message "$2" \
      '.series == $series and .message == $message' <<<"$raw" >/dev/null 2>&1 && rm -f -- "$file"
  done
  return 0
}

# `demo on` and `demo off`, plus a bare `demo` that says which it is. Turning it
# off refreshes the bar at once: a widget still showing invented alarms after
# the shoot is exactly how a plugin gets left in demo mode.
cmd_demo() {
  ensure_dirs
  case "${1:-status}" in
    on)
      : >"$DEMO_FILE"
      chmod 600 "$DEMO_FILE" 2>/dev/null || true
      refresh_panel
      ;;
    off)
      rm -f -- "$DEMO_FILE"
      refresh_panel
      ;;
    status) ;;
    *) die "demo takes on, off or status" ;;
  esac
  if demo_on; then ok_json '{ok: true, demo: true}'; else ok_json '{ok: true, demo: false}'; fi
}

usage() {
  cat <<'EOF'
Usage: nag set <time> [message]     15:15 pick up the kids | 5m tea | tomorrow 9:00 dentist
                                    every fri 15:00 standup | every weekday 9am | daily 8:00
                                    monthly 15 9:00 rent | every month on the 1st at 8
                                    every 5m water | every 30s | every 2 days 9:00 plants
       nag ask                      prompt for one through the Omarchy menu overlay
       nag parse <time> [message]   resolve without setting, for the live preview
       nag list                     every alarm as JSON
       nag snooze <id> [minutes]    default 5, or the snoozeMinutes setting
       nag skip <id>                skip the next occurrence of a repeat
       nag unskip <id>              undo one skip of a repeat
       nag edit <id> <time> [message]
       nag dismiss <id>
       nag cancel <id>
       nag clear
       nag demo on|off|status    invented alarms for screenshots
EOF
}

case ${1:-list} in
  set) shift; cmd_set "$@" ;;
  ask | -i | --interactive) cmd_ask ;;
  parse) shift; cmd_parse "$@" ;;
  list) cmd_list ;;
  snooze) shift; cmd_snooze "$@" ;;
  skip) shift; cmd_skip "$@" ;;
  unskip) shift; cmd_unskip "$@" ;;
  edit) shift; cmd_edit "$@" ;;
  dismiss | cancel) shift; cmd_cancel "$@" ;;
  clear) cmd_clear ;;
  demo) shift; cmd_demo "$@" ;;
  fire) shift; cmd_fire "$@" ;;
  -h | --help | help) usage ;;
  *) usage; exit 1 ;;
esac
